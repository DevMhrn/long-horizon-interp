# Copy to .env (never committed, never sent into Docker build contexts) and fill in.
# Read only by harness/run_model.py, which passes the keys to `harbor run` through the
# process environment — never via --ae, so they are not written into job config files.

# Claude Code harness
ANTHROPIC_API_KEY=
# Codex harness
OPENAI_API_KEY=

# Defaults for harness/run_model.py (override with --agent / --model)
AGENT=codex
MODEL=openai/gpt-5.5
# Codex only: passed as -c model_reasoning_effort=<value>
REASONING_EFFORT=high
